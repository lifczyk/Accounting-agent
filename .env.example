# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_CLASSIFY=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_EXTRACT=google/gemini-2.5-flash-lite

# Google Drive
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_FOLDER_ID=                 # папка "Входящие" — ID из URL папки в Drive
GOOGLE_DRIVE_DONE_FOLDER_ID=            # папка "Обработано"

# 1С (заполнить после получения доступа к тестовому контуру от ИТ-специалиста)
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=

# Пороги confidence (см. обсуждение в документе со схемами)
CLASSIFICATION_CONFIDENCE_THRESHOLD=70
FIELD_CONFIDENCE_THRESHOLD=85
POLL_INTERVAL_SECONDS=180
